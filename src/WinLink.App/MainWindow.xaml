<Window x:Class="WinLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinLink"
        Icon="/WinLink.App;component/Assets/Icons/WinLinkIcon.ico"
        Width="1260"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        Loaded="Window_OnLoaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_文件">
                <MenuItem Click="ExitMenuItem_OnClick" Header="退出" />
            </MenuItem>
            <MenuItem Header="_工具">
                <MenuItem Click="RefreshManagedLinksMenuItem_OnClick" Header="刷新已链接状态" />
                <MenuItem Click="ExecutionHistoryMenuItem_OnClick" Header="执行历史" />
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Click="AboutMenuItem_OnClick" Header="关于" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="WinLink" />
                <TextBlock Foreground="#5F6B7A" Text="创建、检查并管理由 WinLink 维护的文件链接、目录链接与目录镜像同步。" />
            </StackPanel>

            <TabControl x:Name="MainTabControl" Grid.Row="1" SelectionChanged="MainTabControl_OnSelectionChanged">
                <TabItem Header="新建链接">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="待执行任务">
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Padding="14,6" Click="AddPendingTaskButton_OnClick" Content="新增任务" />
                                    <Button Padding="14,6" Click="RemovePendingTaskButton_OnClick" Content="移除任务" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding PendingTasks}"
                                         SelectedItem="{Binding SelectedTask}"
                                         DisplayMemberPath="DisplayName" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="当前任务编辑区">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="0,0,0,12" VerticalAlignment="Top" Text="备注名" />
                                    <Grid Grid.Column="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding SelectedTask.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#5F6B7A"
                                                   Text="复用已链接源" />
                                        <ComboBox Grid.Column="2"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  DisplayMemberPath="DisplayLabel"
                                                  ItemsSource="{Binding ReusableManagedSources}"
                                                  SelectedValue="{Binding SelectedTaskReusableManagedSourceRecordId, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="RecordId" />
                                        <Button Grid.Column="3"
                                                Width="50"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                Click="ClearReusableManagedSourceButton_OnClick"
                                                Content="清除"
                                                IsEnabled="{Binding IsSelectedTaskReusingManagedSource}" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center" Text="源路径" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 IsReadOnly="{Binding IsSelectedTaskReusingManagedSource}"
                                                 LostFocus="SourcePathTextBox_OnLostFocus"
                                                 Text="{Binding SelectedTask.SourcePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                Click="BrowseFileSourceButton_OnClick"
                                                Content="浏览文件..."
                                                IsEnabled="{Binding CanEditSelectedTaskSource}" />
                                        <Button Grid.Column="2"
                                                Margin="0,0,8,0"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                Click="BrowseDirectorySourceButton_OnClick"
                                                Content="浏览目录..."
                                                IsEnabled="{Binding CanEditSelectedTaskSource}" />
                                        <Button Grid.Column="3"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                Click="DetectSourceTypeButton_OnClick"
                                                Content="识别类型"
                                                IsEnabled="{Binding CanEditSelectedTaskSource}" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Margin="0,0,0,12" VerticalAlignment="Center" Text="源类型" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,0,0,12"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedTask.SourceKind}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Margin="0,0,0,12"
                                               Foreground="#5F6B7A"
                                               Text="{Binding SelectedTaskSourceLockHint}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Margin="0,0,0,12" VerticalAlignment="Center" Text="管理模式" />
                                    <ComboBox Grid.Row="4"
                                              Grid.Column="1"
                                              Margin="0,0,0,12"
                                              ItemsSource="{Binding TaskModeOptions}"
                                              SelectedItem="{Binding SelectedTask.Mode}" />

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="1"
                                               Margin="0,0,0,12"
                                               Foreground="#5F6B7A"
                                               Text="{Binding SelectedTaskModeHint}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="6" Margin="0,0,0,12" VerticalAlignment="Center" Text="高级策略" />
                                    <ComboBox Grid.Row="6"
                                              Grid.Column="1"
                                              Margin="0,0,0,12"
                                              IsEnabled="{Binding CanEditSelectedTaskStrategy}"
                                              ItemsSource="{Binding LinkStrategyOptions}"
                                              SelectedItem="{Binding SelectedTask.PreferredStrategy}" />

                                    <GroupBox Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,12" Header="快速添加目标">
                                        <Grid Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center" Text="目标目录" />
                                            <TextBox Grid.Column="1"
                                                     Margin="0,0,8,8"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding DirectoryTargetDirectoryInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Margin="0,0,8,8"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center"
                                                    Click="BrowseTargetDirectoryButton_OnClick"
                                                    Content="选择目录..." />
                                            <Button Grid.Column="3"
                                                    Margin="0,0,0,8"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center"
                                                    Click="AddDirectoryTargetButton_OnClick"
                                                    Content="添加目录目标" />

                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="目标名称" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding DirectoryTargetNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Row="1"
                                                    Grid.Column="3"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center"
                                                    Click="AddFullPathTargetButton_OnClick"
                                                    Content="添加完整路径目标" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Grid.Row="8" Grid.ColumnSpan="2" Header="目标表格">
                                        <DockPanel Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
                                                <Button Margin="0,0,8,0" Padding="14,6" Click="RefreshPreviewButton_OnClick" Content="刷新预检查" />
                                                <Button Padding="14,6" Click="RemoveSelectedTargetButton_OnClick" Content="移除选中目标" />
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="完整目标路径" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding FullTargetPathInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Padding="14,6"
                                                            VerticalAlignment="Center"
                                                            Click="AddFullPathTargetButton_OnClick"
                                                            Content="按完整路径添加" />
                                                </Grid>
                                            </StackPanel>

                                            <DataGrid x:Name="TargetsDataGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CellEditEnding="TargetsDataGrid_OnCellEditEnding"
                                                      HeadersVisibility="Column"
                                                      ItemsSource="{Binding SelectedTask.Targets}"
                                                      SelectedItem="{Binding SelectedTaskTarget}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="150" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Header="目标名" />
                                                    <DataGridTextColumn Width="*" Binding="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Header="目标路径" />
                                                    <DataGridTextColumn Width="120" Binding="{Binding InputMode}" Header="录入模式" IsReadOnly="True" />
                                                    <DataGridTextColumn Width="240" Binding="{Binding ValidationMessage}" Header="预检查提示" IsReadOnly="True" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,16,0,0"
                                Padding="14"
                                Background="#F5F7FA"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Foreground="#4C5B6F" Text="编辑期预检查会在目标行中展示冲突与格式问题；完整校验会检查源是否存在、目标是否冲突以及路径是否完整。" />
                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding ValidationSummary}" />
                                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding ExecutionSummary}" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Padding="16,8" Click="DowngradePreviewButton_OnClick" Content="查看降级确认" />
                                    <Button Margin="0,0,8,0" Padding="16,8" Click="ValidateAllButton_OnClick" Content="先校验全部" />
                                    <Button Padding="16,8" Click="ExecuteAllButton_OnClick" Content="批量执行" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ManagedLinksTabItem" Header="已链接">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <UniformGrid Grid.ColumnSpan="3" Margin="0,0,0,16" Columns="7">
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="源任务" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Records}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="目标总数" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Targets}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="生效中" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Active}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="待同步" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.PendingSync}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="需确认" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Warning}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="失效" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Invalid}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="12" Background="#F5F7FA" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="已断开" />
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedSummary.Disconnected}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <GroupBox Grid.Row="1" Header="受管源任务">
                            <ListBox ItemsSource="{Binding ManagedLinks}" SelectedItem="{Binding SelectedManagedLink}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Foreground="#5F6B7A" FontSize="12" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Text="{Binding StatusSummary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Grid.Column="2" Header="详情">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="0,0,0,12" Text="源名称" />
                                <TextBlock Grid.Column="1" Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding SelectedManagedLink.DisplayName}" />

                                <TextBlock Grid.Row="1" Margin="0,0,0,12" Text="源路径" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Text="{Binding SelectedManagedLink.SourcePath}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Margin="0,0,0,12" Text="源类型" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Text="{Binding SelectedManagedLink.SourceKind}" />

                                <TextBlock Grid.Row="3" Margin="0,0,0,12" Text="管理模式" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Text="{Binding SelectedManagedLinkModeDisplay}" />

                                <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="目标项">
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
                                            <Button Margin="0,0,8,0" Padding="14,6" Click="SyncManagedMirrorButton_OnClick" Content="同步到所有目标" IsEnabled="{Binding CanSyncSelectedManagedMirror}" />
                                            <Button Margin="0,0,8,0" Padding="14,6" Click="RebuildManagedTargetButton_OnClick" Content="重建目标" />
                                            <Button Margin="0,0,8,0" Padding="14,6" Click="DeleteManagedTargetButton_OnClick" Content="删除目标" />
                                            <Button Padding="14,6" Click="RemoveManagedTargetRecordButton_OnClick" Content="移除记录" />
                                        </StackPanel>

                                        <DataGrid AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  ItemsSource="{Binding SelectedManagedLink.Targets}"
                                                  RowDetailsVisibilityMode="Collapsed"
                                                  SelectedItem="{Binding SelectedManagedTarget}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="140" Binding="{Binding DisplayName}" Header="目标" />
                                                <DataGridTextColumn Width="*" Binding="{Binding TargetPath}" Header="路径" />
                                                <DataGridTextColumn Width="100" Binding="{Binding StateDisplayName}" Header="状态" />
                                                <DataGridTemplateColumn Width="120" Header="详情">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Expander Header="查看详情"
                                                                      Expanded="ManagedTargetDetailsExpander_OnExpanded"
                                                                      Collapsed="ManagedTargetDetailsExpander_OnCollapsed">
                                                                <Grid Height="0" />
                                                            </Expander>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Margin="8,0,8,8"
                                                            Padding="12"
                                                            Background="#F5F7FA"
                                                            BorderBrush="#D6DCE5"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding StatusReason}"
                                                                       TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <TextBlock Margin="0,0,18,0"
                                                                           Foreground="#5F6B7A"
                                                                           Text="{Binding AppliedStrategy, StringFormat=最近策略：{0}}" />
                                                                <TextBlock Margin="0,0,18,0"
                                                                           Foreground="#5F6B7A"
                                                                           Text="{Binding LastSynchronizedAt, StringFormat=最近同步：{0:G}}" />
                                                                <TextBlock Foreground="#5F6B7A"
                                                                           Text="{Binding LastCheckedAt, StringFormat=最近检查：{0:G}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                        </DataGrid>
                                    </DockPanel>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="预设">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="内置预设">
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="#5F6B7A" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="预览">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="0,0,0,12" Text="名称" />
                                <TextBlock Grid.Column="1" Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding SelectedPreset.Name}" />

                                <TextBlock Grid.Row="1" Margin="0,0,0,12" Text="源路径" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Text="{Binding SelectedPreset.SourcePathTemplate}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Margin="0,0,0,12" Text="真实源路径" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,0,0,12"
                                           Text="{Binding SelectedPresetPreview.ExpandedSourcePath}"
                                           TextWrapping="Wrap" />

                                <DataGrid Grid.Row="3"
                                          Grid.ColumnSpan="2"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          ItemsSource="{Binding SelectedPresetPreview.Targets}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="140" Binding="{Binding DisplayName}" Header="目标" />
                                        <DataGridTextColumn Width="*" Binding="{Binding ExpandedTargetPath}" Header="真实目标路径" />
                                        <DataGridTextColumn Width="120" Binding="{Binding PreviewState}" Header="状态" />
                                        <DataGridCheckBoxColumn Width="120" Binding="{Binding ParentDirectoryMissing}" Header="缺少父目录" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        Padding="12"
                                        Background="#F5F7FA"
                                        BorderBrush="#D6DCE5"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="预览说明" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="#4C5B6F"
                                                   Text="预设底层仍保留变量路径；当前预览已展开到真实路径，并会标记冲突项和缺失父目录。" />
