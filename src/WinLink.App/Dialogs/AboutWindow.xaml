<Window x:Class="WinLink.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 WinLink"
        Icon="/WinLink.App;component/Assets/Icons/WinLinkIcon.ico"
        Width="460"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="WinLink" />
        <TextBlock Grid.Row="1"
                   Margin="0,16,0,0"
                   Foreground="#445164"
                   TextWrapping="Wrap">
            WinLink 是一个偏原生 Windows 工具气质的桌面链接管理器。
            当前骨架版本已经建立三个主工作区、统一菜单入口以及版本化 JSON 存储基础设施。
        </TextBlock>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Padding="18,6"
                Click="CloseButton_OnClick"
                Content="关闭" />
    </Grid>
</Window>
