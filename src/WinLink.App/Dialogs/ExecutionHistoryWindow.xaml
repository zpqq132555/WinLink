<Window x:Class="WinLink.App.Dialogs.ExecutionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="执行历史"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="执行历史" />
            <TextBlock Foreground="#5F6B7A" Text="查看最近一次或多次校验/执行摘要，并快速定位失败原因。" />
        </StackPanel>

        <DataGrid x:Name="HistoryDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding ExecutionHistory}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="180" Binding="{Binding OccurredAt}" Header="时间" />
                <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="任务摘要" />
                <DataGridTextColumn Width="80" Binding="{Binding SuccessCount}" Header="成功" />
                <DataGridTextColumn Width="80" Binding="{Binding SkippedCount}" Header="跳过" />
                <DataGridTextColumn Width="80" Binding="{Binding FailedCount}" Header="失败" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Padding="14"
                Background="#F5F7FA"
                BorderBrush="#D6DCE5"
                BorderThickness="1"
                CornerRadius="6"
                DataContext="{Binding ElementName=HistoryDataGrid, Path=SelectedItem}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock FontWeight="SemiBold" Grid.ColumnSpan="2" Text="选中记录详情" />

                <TextBlock Grid.Row="1" Margin="0,12,0,8" Text="摘要" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,8" Text="{Binding Summary, TargetNullValue=请选择一条历史记录}" TextWrapping="Wrap" />

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="结果汇总">
                        <UniformGrid Margin="12" Columns="3">
                            <Border Margin="0,0,8,0" Padding="10" Background="White" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="成功" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SuccessCount}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Padding="10" Background="White" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="跳过" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SkippedCount}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Background="White" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Foreground="#5F6B7A" Text="失败" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding FailedCount}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="失败原因">
                        <ListBox Margin="12,8,12,12" ItemsSource="{Binding FailureReasons}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FailureReasons.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
