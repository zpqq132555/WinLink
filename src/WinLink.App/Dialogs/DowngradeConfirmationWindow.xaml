<Window x:Class="WinLink.App.Dialogs.DowngradeConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="降级确认"
        Width="720"
        Height="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="统一降级确认" />
            <TextBlock Foreground="#5F6B7A"
                       Text="以下目标无法按推荐策略创建，但可以使用替代策略继续执行。确认后将按替代策略尽力执行。" />
        </StackPanel>

        <DataGrid x:Name="DowngradeItemsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Width="150" Binding="{Binding TaskDisplayName}" Header="任务" />
                <DataGridTextColumn Width="140" Binding="{Binding TargetDisplayName}" Header="目标" />
                <DataGridTextColumn Width="*" Binding="{Binding TargetPath}" Header="目标路径" />
                <DataGridTextColumn Width="110" Binding="{Binding RecommendedStrategy}" Header="推荐策略" />
                <DataGridTextColumn Width="110" Binding="{Binding FallbackStrategy}" Header="替代策略" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="18,6" Click="CancelButton_OnClick" Content="取消" />
            <Button Padding="18,6" Click="ConfirmButton_OnClick" Content="确认并继续" />
        </StackPanel>
    </Grid>
</Window>
