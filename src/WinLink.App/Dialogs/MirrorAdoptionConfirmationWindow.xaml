<Window x:Class="WinLink.App.Dialogs.MirrorAdoptionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="镜像采纳确认"
        Icon="/WinLink.App;component/Assets/Icons/WinLinkIcon.ico"
        Width="720"
        Height="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="镜像采纳确认" />
            <TextBlock Foreground="#5F6B7A"
                       Text="下列目标目录已经与源目录一致。确认后只会登记受管镜像基线，不会再次复制文件。" />
        </StackPanel>

        <DataGrid x:Name="AdoptionItemsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Width="150" Binding="{Binding TaskDisplayName}" Header="任务" />
                <DataGridTextColumn Width="140" Binding="{Binding TargetDisplayName}" Header="目标" />
                <DataGridTextColumn Width="*" Binding="{Binding TargetPath}" Header="目标路径" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="18,6" Click="CancelButton_OnClick" Content="取消" />
            <Button Padding="18,6" Click="ConfirmButton_OnClick" Content="确认" />
        </StackPanel>
    </Grid>
</Window>
